# Placeholders only. Populate locally, never commit a populated .env.
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
AI_ENABLED=false
AI_PROCESSING_MODE=disabled
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_MODEL=configure_locally
AI_PROVIDER_ID=verify_before_enabling
AI_POLICY_VERSION=unconfigured
AI_API_KEY=configure_locally
AI_TIMEOUT_SECONDS=45
AI_MAX_ATTEMPTS=2
AI_MAX_INPUT_CHARS_PER_BATCH=10000
AI_CONCURRENCY=1
# Path must not be cloud-synced. Set outside repository in real setup.
LOCAL_DATA_DIR=configure_private_linux_directory
LOCAL_UI_BIND=127.0.0.1
# Receiver stays disabled until private interface, TLS and pairing configured.
PHONE_RECEIVER_ENABLED=false
PHONE_RECEIVER_BIND=configure_private_interface
PHONE_RECEIVER_TLS_CERT=configure_local_path
PHONE_RECEIVER_TLS_KEY=configure_local_path
ACADEMIC_OS_API_URL=https://your-protected-worker.workers.dev/api/v1
COLLECTOR_KEY_ID=configure_locally
COLLECTOR_HMAC_SECRET=configure_locally
# Raw cloud upload is prohibited; no environment flag enables it.
