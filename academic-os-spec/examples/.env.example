# Copy locally only. DO NOT commit populated .env files.
# Arch collector + existing local 9Router
AI_ENABLED=false
AI_ALLOW_REMOTE_PROCESSING=false
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_MODEL=your-model-route
AI_API_KEY=replace_locally
AI_TIMEOUT_SECONDS=45
AI_MAX_ATTEMPTS=2
AI_MAX_INPUT_CHARS_PER_BATCH=10000
AI_CONCURRENCY=1

# API sync: set only after authenticated Worker is deployed
ACADEMIC_OS_API_URL=https://your-protected-worker.workers.dev/api/v1
COLLECTOR_KEY_ID=local-collector-id
COLLECTOR_HMAC_SECRET=replace_locally

# Non-secret defaults
APP_TIMEZONE=Asia/Makassar
WHATSAPP_IMPORT_DIR=./private/imports
LOCAL_DATA_DIR=./private/data
UPLOAD_RAW_CHATS=false
DEFAULT_REDACT_SENDER_NAMES=true
